# -----------------------------------------------------------------------------
# ISHKEEN ENVIRONMENT VARIABLES (.env.example)
# -----------------------------------------------------------------------------
# Copy this file to .env and fill in the values before running the application.
# -----------------------------------------------------------------------------

# ==========================================
# APPLICATION CONFIGURATION
# ==========================================
ENVIRONMENT=development
APP_URL=http://localhost:5173

# ==========================================
# BACKEND API
# ==========================================
# CORS Settings (Comma-separated list of allowed origins)
BACKEND_CORS_ORIGINS=["http://localhost:5173"]

# ==========================================
# DATABASE (PostgreSQL)
# ==========================================
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ishkeen
POSTGRES_PORT=5432

# ==========================================
# AUTHENTICATION
# ==========================================
SESSION_COOKIE_NAME=ishkeen_session
SESSION_EXPIRE_MINUTES=10080

# Admin Portal Credentials
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_secure_password_here

# ==========================================
# GOOGLE OAUTH
# ==========================================
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback

# ==========================================
# STORAGE
# ==========================================
UPLOAD_DIR=private_uploads

# ==========================================
# EMAIL NOTIFICATIONS (Resend)
# ==========================================
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=noreply@ishkeen.com

# ==========================================
# FRONTEND CONFIGURATION
# ==========================================
VITE_API_BASE_URL=http://localhost:8000/api
VITE_DEBUG_MODE=true

# ==========================================
# ML PIPELINE (GEMINI VISION)
# ==========================================
GEMINI_API_KEY=your_gemini_api_key_here
